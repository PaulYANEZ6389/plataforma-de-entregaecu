{
  "name": "plataforma-de-entregaecu",
  "version": "1.0.0",
  "description": "Plataforma de monitoreo y gestión para asesores de soporte de EntregaECU, con integración a Firebase para administrar apps de conductor y cliente.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "echo 'No hay proceso de build configurado'",
    "deploy": "firebase deploy",
    "format": "prettier --write ."
  },
  "keywords": [
    "firebase",
    "entregaecu",
    "monitoreo",
    "soporte",
    "conductor",
    "cliente",
    "nodejs",
    "express"
  ],
  "author": "Tu Nombre o Empresa",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^11.7.3",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "jest": {
    "testEnvironment": "node"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/plataforma-de-entregaecu.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/plataforma-de-entregaecu/issues"
  },
  "homepage": "https://entregaecu.web.app"
}
